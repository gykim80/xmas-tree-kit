{
  "name": "xmas-tree-kit",
  "version": "0.1.0",
  "description": "Procedural Christmas trees for three.js: grow a fir, decorate it, drop it into a game or a web page.",
  "type": "module",
  "license": "MIT",
  "author": "andrew <gybryce@gmail.com>",
  "keywords": ["three", "threejs", "christmas", "tree", "procedural", "web-component", "glb", "gltf"],
  "main": "./dist/xmas-tree-kit.js",
  "module": "./dist/xmas-tree-kit.js",
  "exports": {
    ".": {
      "import": "./dist/xmas-tree-kit.js",
      "default": "./dist/xmas-tree-kit.js"
    },
    "./element": "./dist/element.js",
    "./standalone": "./dist/xmas-tree.standalone.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": ["./dist/element.js", "./dist/xmas-tree.standalone.js", "./src/element-define.js", "./src/standalone.js"],
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "lil-gui": "^0.21.0",
    "playwright": "^1.65.0",
    "three": "^0.187.0",
    "vite": "^8.3.6"
  },
  "scripts": {
    "dev": "vite --config vite.site.config.js",
    "build": "vite build --config vite.lib.config.js && vite build --config vite.standalone.config.js",
    "build:site": "vite build --config vite.site.config.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs"
  }
}
